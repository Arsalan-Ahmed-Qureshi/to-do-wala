{
  "compilerOptions": {
    "jsx": "react-native",
    "lib": [
      "es2020"
    ],
    "module": "esnext",
    "target": "es2020",
    "resolveJsonModule": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ],
  "extends": "expo/tsconfig.base"
}
